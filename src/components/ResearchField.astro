---
// A topographic field suggests the complicated behavior a tester explores.
// The contours are illustrative rather than a chart of measured data.
const center = { x: 260, y: 278 };
const pointOnContour = (ring, angle) => {
  const radius = 41 + ring * 23;
  const ripple = 1 + .075 * Math.sin(3 * angle + ring * .34) + .035 * Math.sin(7 * angle - ring * .45);
  return {
    x: center.x + Math.cos(angle) * radius * ripple,
    y: center.y + Math.sin(angle) * radius * ripple * .83,
  };
};
const contours = Array.from({ length: 10 }, (_, ring) => {
  const points = Array.from({ length: 100 }, (_, step) => pointOnContour(ring, step / 100 * Math.PI * 2));
  return `M${points.map(({ x, y }) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L')}Z`;
});
const marks = [
  { ...pointOnContour(3, 2.7), radius: 3.5 },
  { ...pointOnContour(5, 1.35), radius: 4 },
  { ...pointOnContour(7, 3.9), radius: 3 },
  { ...pointOnContour(6, 5.3), radius: 3.5 },
];
const discovery = pointOnContour(7, -.38);
const isSpanish = Astro.props.locale === 'es';
---
<div class="hero-art" role="img" aria-label={isSpanish ? "Mapa topográfico abstracto del comportamiento del software. Las curvas y los puntos sugieren la exploración de sistemas complejos; un punto cálido destaca un caso inesperado." : "Abstract topographic field of software behavior. Contour lines and marked points evoke exploring complex systems, with one warm-colored point drawing attention to an unexpected edge."}>
  <div class="art-top"><span>{isSpanish ? 'Software / bajo prueba' : 'Software / under test'}</span><span>{isSpanish ? 'Investigación · seguridad' : 'Research · security'}</span></div>
  <svg viewBox="0 0 520 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <radialGradient id="field-glow"><stop stop-color="#618a75" stop-opacity=".28"/><stop offset=".6" stop-color="#476e66" stop-opacity=".12"/><stop offset="1" stop-color="#1e3336" stop-opacity="0"/></radialGradient>
      <linearGradient id="contour-accent" x1=".1" y1=".9" x2=".95" y2=".1"><stop stop-color="#81bba9"/><stop offset=".58" stop-color="#bce47d"/><stop offset="1" stop-color="#e7b184"/></linearGradient>
      <radialGradient id="discovery-glow"><stop stop-color="#eab58a" stop-opacity=".46"/><stop offset="1" stop-color="#eab58a" stop-opacity="0"/></radialGradient>
    </defs>
    <g class="art-grid" fill="none" stroke="#6c8b84" stroke-width=".7" opacity=".19">
      <path d="M0 80H520M0 160H520M0 240H520M0 320H520M0 400H520M0 480H520"/>
      <path d="M80 0V560M160 0V560M240 0V560M320 0V560M400 0V560M480 0V560"/>
    </g>
    <circle cx={center.x} cy={center.y} r="222" fill="url(#field-glow)"/>
    <g class="art-contours" fill="none" stroke="#83aa96" stroke-width="1.25">
      {contours.map((path, index) => <path d={path} opacity={.56 - index * .026} />)}
    </g>
    <path d={contours[5]} fill="none" stroke="url(#contour-accent)" stroke-width="2.4" opacity=".94"/>
    <g fill="#c8e4a4" stroke="#1e3336" stroke-width="2">
      {marks.map((mark) => <circle cx={mark.x} cy={mark.y} r={mark.radius} />)}
    </g>
    <circle cx={discovery.x} cy={discovery.y} r="42" fill="url(#discovery-glow)" class="art-discovery-glow"/>
    <circle cx={discovery.x} cy={discovery.y} r="25" fill="none" stroke="#e9b68c" stroke-width="1" opacity=".7" class="art-discovery-ring"/>
    <circle cx={discovery.x} cy={discovery.y} r="7" fill="#f2b286" stroke="#1e3336" stroke-width="3"/>
  </svg>
  <div class="art-bottom"><span>{isSpanish ? 'Explorando los límites del software.' : 'Exploring software behavior at its edges.'}</span></div>
</div>
<style>
  .hero-art{width:100%;aspect-ratio:1/1.08;min-height:540px;background:#1e3336;border-radius:27px;position:relative;overflow:hidden;box-shadow:0 24px 58px #2a444222}
  .hero-art:after{content:'';position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(to bottom,#1e3336b8,transparent 19%,transparent 79%,#1e3336d9)}
  .hero-art svg{position:absolute;inset:0;width:100%;height:100%}
  .art-top,.art-bottom{position:absolute;z-index:2;left:28px;right:28px;display:flex;justify-content:space-between;gap:14px;color:#c9ddd1;text-transform:uppercase;letter-spacing:.11em;font:500 10px/1.4 'DM Mono',monospace}
  .art-top{top:27px}.art-bottom{bottom:26px}.art-bottom span:first-child{text-transform:none;letter-spacing:.02em;font-size:11px}
  @media(max-width:700px){.hero-art{max-width:530px;min-height:0;aspect-ratio:1/1.02}}
  @media(max-width:480px){.art-top,.art-bottom{font-size:8px;left:20px;right:20px}.art-bottom span:first-child{font-size:9px}}
  @media(prefers-reduced-motion:no-preference){
    .art-discovery-glow,.art-discovery-ring{transform-box:fill-box;transform-origin:center;animation:discovery-breathe 4.5s ease-in-out infinite}
    .art-discovery-ring{animation-delay:.35s}
    @keyframes discovery-breathe{0%,100%{opacity:.65;transform:scale(.92)}50%{opacity:1;transform:scale(1.12)}}
  }
</style>
