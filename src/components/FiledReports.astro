---
import { filedReports } from '../lib/data.js';
import { filedReportCopy } from '../lib/es-data.js';
const locale = Astro.props.locale ?? 'en';
const isSpanish = locale === 'es';
const number = (value) => value.toLocaleString(isSpanish ? 'es-ES' : 'en-US');
const visibleCount = 12;

const projects = [...filedReports.projects]
  .sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0))
  .map((project) => ({
    ...project,
    items: project.items.map((item) => ({ ...item, title: isSpanish ? filedReportCopy[item.issueUrl ?? item.prUrl] ?? item.title : item.title })),
  }));
const items = projects.flatMap((project) => project.items);
const withFix = items.filter((item) => item.prUrl || item.patchInReport).length;
const stars = projects.reduce((total, project) => total + (project.stars ?? 0), 0);
const shown = projects.slice(0, visibleCount);
const rest = projects.slice(visibleCount);
const t = isSpanish ? {
  kicker: 'Enviados a otros proyectos · en revisión',
  title: 'Informes y correcciones abiertos.',
  intro: 'Fallos que encontré con Fandango y comuniqué a los proyectos responsables del código, casi siempre con la corrección lista para integrar. Son públicos y esperan la revisión de los mantenedores; cuando se integren pasarán a la lista de correcciones.',
  stats: [`fallos comunicados o corregidos`, `con PR o parche de corrección`, `proyectos, de Go y OpenCV a FFmpeg`, `estrellas en GitHub entre todos`],
  report: 'Informe', original: 'Issue original', pr: 'PR con la corrección', patch: 'Parche en el informe',
  mirror: 'espejo', more: `Ver ${rest.length} proyectos más`,
  note: `Estado comprobado el ${filedReports.checkedEs}. Otros ${filedReports.privateReports} informes se enviaron en privado a los mantenedores (avisos de seguridad de GitHub y correo); aparecerán aquí cuando estén corregidos y publicados. Otros ${filedReports.issueComments} comentarios aportan la causa o la corrección a issues abiertos por otras personas. Las estrellas son totales de cada proyecto en GitHub (FFmpeg y file: sus espejos oficiales) y no miden instalaciones afectadas.`,
} : {
  kicker: 'Filed upstream · under review',
  title: 'Open bug reports and fixes.',
  intro: 'Bugs I found with Fandango and reported to the projects that own the code, most with a fix ready to merge. They are public and waiting for maintainer review; each moves to the fixes above once it is merged.',
  stats: ['bugs reported or fixed', 'with a fix PR or patch', 'projects, from Go and OpenCV to FFmpeg', 'GitHub stars across them'],
  report: 'Report', original: 'Original issue', pr: 'Fix PR', patch: 'Patch in report',
  mirror: 'mirror', more: `Show ${rest.length} more projects`,
  note: `Status checked ${filedReports.checked}. A further ${filedReports.privateReports} reports went privately to maintainers (GitHub security advisories and e-mail); they will be listed here once fixed and published. Another ${filedReports.issueComments} comments add the root cause or a fix to issues that others opened. Stars are GitHub project totals (FFmpeg and file: their official mirrors) and do not count affected installations.`,
};
const statValues = [number(items.length), number(withFix), number(projects.length), `${Math.round(stars / 1000)}k`];
---
<section class="wrap filed" id="filed" aria-labelledby="filed-title">
  <div class="filed-heading"><span class="section-kicker">{t.kicker}</span><h2 class="section-title" id="filed-title">{t.title}</h2><p>{t.intro}</p></div>
  <div class="filed-stats">{statValues.map((value, index) => <div><strong>{value}</strong><span>{t.stats[index]}</span></div>)}</div>
  {[shown, rest].map((group, groupIndex) => {
    const list = <div class="filed-list">{group.map((project) => <article class="filed-project">
      <div class="filed-side"><a href={project.url} target="_blank" rel="noopener noreferrer">{project.name} ↗</a><span>{project.language}{typeof project.stars === 'number' && ` · ★ ${number(project.stars)}`}{project.mirror && ` (${t.mirror})`}</span></div>
      <ul>{project.items.map((item) => <li><span class="filed-title">{item.title}</span><span class="filed-links">{item.issueUrl && <a href={item.issueUrl} target="_blank" rel="noopener noreferrer">{item.existingIssue ? t.original : t.report} ↗</a>}{item.prUrl && <a href={item.prUrl} target="_blank" rel="noopener noreferrer">{t.pr} ↗</a>}{item.patchInReport && <span>{t.patch}</span>}</span></li>)}</ul>
    </article>)}</div>;
    return groupIndex === 0 ? list : group.length > 0 && <details class="filed-more"><summary>{t.more}</summary>{list}</details>;
  })}
  <p class="filed-note">{t.note}</p>
</section>
<style>
  .filed{padding-top:110px}
  .filed-heading{margin-bottom:30px}
  .filed-heading p{max-width:720px;margin:18px 0 0;color:#62716e;line-height:1.7}
  .filed-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:34px}
  .filed-stats div{background:#e9eee5;border-radius:20px;padding:24px 24px 26px;display:flex;flex-direction:column;gap:10px}
  .filed-stats strong{font:800 clamp(40px,4.4vw,58px)/1 'Manrope',sans-serif;letter-spacing:-.06em;color:#253b3c}
  .filed-stats span{color:#5d6f69;font:500 11px/1.5 'DM Mono',monospace}
  .filed-list{border-top:1px solid #d3ddd4}
  .filed-project{display:grid;grid-template-columns:220px 1fr;gap:25px;border-bottom:1px solid #d3ddd4;padding:20px 0}
  .filed-side{display:flex;flex-direction:column;gap:6px}
  .filed-side a{font:800 17px/1.3 'Manrope',sans-serif;letter-spacing:-.03em;color:#253b3c}
  .filed-side a:hover,.filed-side a:focus-visible{text-decoration:underline;text-decoration-color:#a4d552;text-underline-offset:4px}
  .filed-side span{font:500 11px/1.6 'DM Mono',monospace;color:#758a74}
  .filed-project ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
  .filed-project li{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 18px}
  .filed-title{font-size:14px;line-height:1.5;color:#3c4f4d;flex:1 1 320px}
  .filed-links{display:flex;flex-wrap:wrap;gap:6px 14px;font:600 11px 'DM Mono',monospace;white-space:nowrap}
  .filed-links a{color:#426837}
  .filed-links a:hover,.filed-links a:focus-visible{text-decoration:underline;text-underline-offset:3px}
  .filed-links span{color:#758a74}
  .filed-more summary{cursor:pointer;padding:18px 0;font:600 12px 'DM Mono',monospace;color:#426837;border-bottom:1px solid #d3ddd4}
  .filed-more summary:hover,.filed-more summary:focus-visible{text-decoration:underline;text-underline-offset:3px}
  .filed-more[open] summary{border-bottom:0}
  .filed-note{margin:18px 0 0;color:#708078;font:500 11px/1.6 'DM Mono',monospace}
  @media(max-width:700px){.filed-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.filed-project{grid-template-columns:1fr;gap:10px}.filed-links{white-space:normal}}
</style>
