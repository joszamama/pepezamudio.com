---
import { posts } from '../../lib/posts.js';
export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { slug: post.slug } }));
}
const { slug } = Astro.props;
const target = `../../blog/${slug}/`;
const canonical = new URL(`/blog/${slug}/`, Astro.site).toString();
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><title>Blog — Pepe Zamudio</title><link rel="canonical" href={canonical} /><meta name="robots" content="noindex" /><meta http-equiv="refresh" content={`0;url=${target}`} /></head><body><p>This post moved to <a href={target}>Blog</a>.</p><script is:inline define:vars={{ target }}>location.replace(new URL(target + location.search + location.hash, location.href));</script></body></html>
