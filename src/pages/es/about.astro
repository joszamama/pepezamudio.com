---
import Base from '../../layouts/Base.astro';
import ImpactMetrics from '../../components/ImpactMetrics.astro';
import TalkMap from '../../components/TalkMap.astro';
import TeachingService from '../../components/TeachingService.astro';
const path = [
  { date: '2018–2022', title: 'Grado en Ingeniería del Software', place: 'Universidad de Sevilla', detail: 'Estudié en el programa bilingüe y, en enero de 2022, empecé a trabajar como investigador estudiante en Diverso Lab, el grupo de David Benavides. Allí investigué las líneas de productos software y desarrollé WebSPL. Obtuve tres Matrículas de Honor en asignaturas del grado; mi trabajo fin de grado también recibió una distinción de honor. Fui seleccionado para presentar WebSPL en JISBD 2022, una de las principales conferencias españolas de ingeniería del software.', link: 'https://hdl.handle.net/11705/JISBD/2022/2185', linkLabel: 'WebSPL' },
  { date: '2022–2023', title: 'Máster en Ingeniería del Software', place: 'Universidad de Sevilla', detail: 'Seguí en el grupo de Benavides y asumí otro puesto de investigador estudiante en la Universidad Pablo de Olavide, donde estudié heurísticas matemáticas y optimización. También colaboré con Jordi Cabot, entonces en LIST y vinculado a la Universidad de Luxemburgo, en XatkitSPL. Mi trabajo fin de máster recibió la máxima distinción y fui seleccionado para presentar XatkitSPL en JISBD 2023.', link: 'https://hdl.handle.net/11705/JISBD/2023/9205', linkLabel: 'XatkitSPL' },
  {
    date: 'Oct 2023–actualidad', title: 'Doctorado en Informática', place: 'Universidad del Sarre · CISPA',
    detail: 'Me incorporé al grupo de Andreas Zeller en CISPA para investigar cómo generar pruebas de entradas complejas. Creé Fandango y trabajé en generación guiada por distribuciones y restricciones, pruebas de inyección XML y fuzzing personalizado. También continué una colaboración sobre optimización de grafos con la Universidad Pablo de Olavide.',
    highlights: [
      { date: 'Sep 2024', datetime: '2024-09', headline: 'Controlé la distribución de entradas generadas con gramáticas.', text: 'Una prueba de concepto con JSON dirigió los valores de edad y presupuesto hacia distribuciones elegidas sin incumplir sus restricciones. La evalué con 1.000 entradas; la mejora en detección de fallos quedó para trabajos futuros.', source: 'Simposio doctoral de ISSTA 2024', url: 'https://doi.org/10.1145/3650212.3685553' },
      { date: 'Feb 2025', datetime: '2025-02', headline: 'Extendí la optimización de conjuntos dominantes a grafos ponderados.', text: 'En el artículo de MATCOM formulamos el problema k-ponderado y evaluamos métodos heurísticos. En el caso particular sin pesos, un método voraz iterativo obtuvo soluciones comparables en aproximadamente la mitad del tiempo de cálculo del método de referencia.', source: 'Artículo en MATCOM', url: 'https://doi.org/10.1016/j.matcom.2024.09.010' },
      { date: 'Jun 2025', datetime: '2025-06', headline: 'Convertí contratos de servicios web en pruebas de inyección XML.', text: 'XAVIER genera entradas de ataque a partir de gramáticas derivadas de WSDL. En una comparación preliminar con ocho WSDL públicos, cubrió la funcionalidad especificada de forma comparable a SoapUI Pro.', source: 'Artículo sobre XAVIER en ISSTA 2025', url: 'https://doi.org/10.1145/3713081.3731736' },
      { date: 'Jun 2025', datetime: '2025-06', headline: 'Probé un módulo GNSS real con casos límite específicos.', text: 'En el caso de estudio describimos mensajes binarios UBX mediante una gramática y restricciones del dominio, incluidos valores válidos y casos deliberados de NaN e infinito. En esa ejecución, el módulo aceptó los mensajes válidos y rechazó los inválidos; no se notificó ninguna vulnerabilidad.', source: 'Artículo breve sobre GNSS en ISSTA 2025', url: 'https://doi.org/10.1145/3713081.3731722' },
      { date: 'Jun 2025', datetime: '2025-06', headline: 'Aceleré la generación de entradas de prueba complejas y válidas.', text: 'En cinco formatos de referencia, Fandango generó entradas entre 29 y 1.355 veces más rápido que el solucionador simbólico ISLa; los analizadores aceptaron entre el 99,27 % y el 100 % de las salidas.', source: 'Artículo sobre Fandango en ISSTA 2025', url: 'https://doi.org/10.1145/3728915' },
    ],
    visit: {
      date: 'Sep–dic 2025', title: 'Investigador visitante en Max Planck', place: 'Instituto Max Planck de Seguridad y Privacidad · Bochum, Alemania',
      detail: 'Trabajé con Marcel Böhme en modelos estadísticos del fuzzing guiado por cobertura. Estudié cómo se relaciona la distribución de características de las entradas con la saturación de cobertura y dónde están los límites de la generación basada en gramáticas. Ese trabajo dio pie a mi investigación posterior sobre pruebas centradas en características.',
    },
    laterDetail: 'De vuelta en CISPA, continué el doctorado con Andreas Zeller. Desde entonces he extendido las pruebas basadas en lenguajes a conversaciones con estado entre protocolos, entradas muy restringidas y conjuntos de pruebas centrados en características concretas.',
    laterHighlights: [
      { date: 'Feb 2026', datetime: '2026-02', headline: 'Generé conversaciones completas entre protocolos con estado.', text: 'Las gramáticas de interacción modelan los mensajes y su estado cambiante en protocolos como SMTP, DNS y FTP. En un estudio de caso con FTP, Fandango alcanzó un 80,3 % de cobertura de instrucciones en unos 14 minutos; AFLNET llegó a una mediana del 69,6 % después de un día.', source: 'Preprint revisado sobre pruebas de protocolos', url: 'https://arxiv.org/abs/2509.20308' },
      { date: 'Jul 2026', datetime: '2026-07', headline: 'Llevé las pruebas basadas en lenguajes a la enseñanza práctica.', text: 'Los métodos de nuestro tutorial de FSE ya se habían enseñado en la escuela de verano RIO a más de 100 participantes: gramáticas, restricciones y pruebas de protocolos con estado.', source: 'Tutorial de FSE 2026', url: 'https://doi.org/10.1145/3803437.3804899' },
      { date: 'Jul 2026', datetime: '2026-07', headline: 'Hice viable generar pruebas de compiladores con muchas restricciones.', text: 'Fandango-RS compila gramáticas a Rust y utiliza búsqueda multiobjetivo. En el estudio del preprint revisado sobre un subconjunto restringido de C, generó 877 programas válidos en aproximadamente un minuto, mientras que el método anterior no generó ninguno. La mejora de tres a cuatro órdenes de magnitud se refiere a las operaciones internas.', source: 'Preprint de Fandango-RS · v3', url: 'https://arxiv.org/abs/2511.05987v3' },
      { date: 'Oct 2026', datetime: '2026-10', headline: 'Centré las pruebas en características concretas sin perder cobertura medida.', text: 'Compás transforma una especificación de formato en conjuntos de pruebas para características concretas. En diez formatos, uno o dos conjuntos conservaron la cobertura de líneas agregada del conjunto completo; de media, todas las entradas enfocadas alcanzaron la región de código prevista, frente al 26 % de las entradas generadas sin ese enfoque.', source: 'Artículo sobre Compás en ASE 2026', url: 'https://doi.org/10.1145/3832783.3837479' },
    ],
  },
];
---
<Base locale="es" title="Sobre mí — Pepe Zamudio" description="José Antonio «Pepe» Zamudio Amaya investiga en CISPA cómo probar sistemas complejos mediante fuzzing y generación de entradas.">
  <div class="wrap page-intro"><div class="eyebrow">Sobre mí</div><h1>De Sevilla a Saarbrücken<span>.</span></h1><p>Formación, puestos de investigación y lo que he hecho en cada etapa.</p></div>
  <div class="wrap rule"></div>
  <section class="wrap bio"><div class="bio-main"><h2>Investigo en pruebas de software y seguridad.</h2><p>Empecé como investigador estudiante en Sevilla, desarrollando herramientas para líneas de productos software en la Universidad de Sevilla y trabajando en problemas de optimización en la Universidad Pablo de Olavide. En octubre de 2023 me trasladé a Saarbrücken para hacer el doctorado con Andreas Zeller en <a href="https://cispa.de/" target="_blank" rel="noopener noreferrer">CISPA</a>.</p><p>Desde entonces trabajo en la generación de pruebas para entradas complejas e interacciones entre protocolos. En el Instituto Max Planck de Seguridad y Privacidad estudié cómo las características de las entradas afectan a la cobertura del fuzzing; esa visita orientó mis investigaciones posteriores sobre pruebas enfocadas.</p></div><aside class="bio-side"><div class="bio-card"><span class="section-kicker">En breve</span><dl><div><dt>Vivo en</dt><dd>Saarbrücken, Alemania</dd></div><div><dt>Puesto actual</dt><dd>Doctorando, CISPA</dd></div><div><dt>Investigación</dt><dd>Fuzzing · Pruebas · Seguridad</dd></div><div><dt>Origen</dt><dd>Sevilla, España</dd></div></dl><a class="pill-button light" href="/cv-july-2026.pdf" target="_blank" rel="noopener noreferrer">Descargar CV (julio de 2026) ↓</a></div></aside></section>
  <ImpactMetrics locale="es" />
  <section class="wrap timeline" aria-labelledby="path-title"><div class="timeline-heading"><span class="section-kicker">Mi recorrido</span><h2 class="section-title" id="path-title">Dónde he estado.</h2><p class="timeline-note">Las fechas de los resultados corresponden a la publicación o a la última revisión del preprint.</p></div><ol class="timeline-list">{path.map((item) => <li><span class="timeline-date">{item.date}</span><h3>{item.title}</h3><strong>{item.place}</strong><p>{item.detail}</p>{item.link && <a href={item.link} target="_blank" rel="noopener noreferrer">Leer el artículo sobre {item.linkLabel} ↗</a>}{item.highlights && <ul class="timeline-impact" aria-label={`${item.title} resultados de investigación`}>{item.highlights.map((highlight) => <li><a href={highlight.url} target="_blank" rel="noopener noreferrer"><div><time class="highlight-date" datetime={highlight.datetime}>{highlight.date}</time><h4>{highlight.headline}</h4></div><span>{highlight.text}<small>{highlight.source} ↗</small></span></a></li>)}</ul>}{item.visit && <aside class="timeline-branch" aria-label="Estancia de investigación durante el doctorado"><span class="branch-dot" aria-hidden="true"></span><span class="timeline-date">{item.visit.date}</span><h4>{item.visit.title}</h4><strong>{item.visit.place}</strong><p>{item.visit.detail}</p></aside>}{item.laterDetail && <div class="timeline-resume"><span class="timeline-date">Ene 2026–actualidad · CISPA</span><p>{item.laterDetail}</p><ul class="timeline-impact" aria-label="Resultados posteriores del doctorado">{item.laterHighlights.map((highlight) => <li><a href={highlight.url} target="_blank" rel="noopener noreferrer"><div><time class="highlight-date" datetime={highlight.datetime}>{highlight.date}</time><h4>{highlight.headline}</h4></div><span>{highlight.text}<small>{highlight.source} ↗</small></span></a></li>)}</ul></div>}</li>)}</ol></section>
  <TeachingService locale="es" />
  <TalkMap locale="es" />
</Base>
<style>.page-intro h1 span{color:#a1c066}.bio{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.7fr);gap:90px;padding-top:75px}.bio-main h2{font:800 clamp(30px,3.6vw,46px)/1.22 'Manrope',sans-serif;letter-spacing:-.05em;margin:0 0 35px}.bio-main p{font-size:17px;line-height:1.8;color:#596a65;margin:0 0 23px}.bio-main a{text-decoration:underline;text-decoration-color:#b4c8ad;text-underline-offset:4px}.bio-card{background:#263f40;color:#fff;border-radius:22px;padding:28px;position:sticky;top:25px}.bio-card .section-kicker{color:#b9da86}.bio-card dl{margin:18px 0}.bio-card dl div{border-top:1px solid #4b6560;padding:13px 0}.bio-card dt{font:500 10px 'DM Mono',monospace;color:#a9beb3;text-transform:uppercase;letter-spacing:.1em;margin-bottom:7px}.bio-card dd{margin:0;font-size:15px;font-weight:700}.bio-card .pill-button{width:100%;font-size:11px;padding:14px}.timeline{display:grid;grid-template-columns:1fr 1.2fr;gap:80px;padding-top:110px}.timeline-list{border-top:1px solid #d7ded8}.timeline-list>div{border-bottom:1px solid #d7ded8;padding:23px 0}.timeline-list span{font:500 11px 'DM Mono',monospace;color:#779358}.timeline-list h3{font:800 22px 'Manrope',sans-serif;letter-spacing:-.04em;margin:8px 0}.timeline-list p{line-height:1.6;color:#64736d;margin:0}@media(max-width:850px){.bio{grid-template-columns:1fr;gap:30px}.bio-card{position:static}.timeline{grid-template-columns:1fr;gap:25px}}</style>
<style>
  :global(.site-footer){margin-top:0}
  .timeline{display:block;padding-top:105px}
  .timeline-heading{margin-bottom:45px}
  .timeline-heading h2{margin:14px 0 0}
  .timeline-note{font:500 11px/1.6 'DM Mono',monospace;color:#71827a;margin:17px 0 0;max-width:730px}
  .timeline-list{list-style:none;border-top:0;border-left:2px solid #cbd9c5;margin:0 0 0 10px;padding:0 0 0 42px}
  .timeline-list>li{position:relative;padding:0 0 48px}
  .timeline-list>li:last-child{padding-bottom:0}
  .timeline-list>li:before{content:'';position:absolute;left:-52px;top:4px;width:16px;height:16px;background:#a6cd72;border:3px solid #f6f5ef;border-radius:50%;box-shadow:0 0 0 2px #a6cd72}
  .timeline-date{font:500 11px 'DM Mono',monospace;color:#779358}
  .timeline-list h3{font:800 clamp(26px,3vw,36px)/1.15 'Manrope',sans-serif;letter-spacing:-.045em;margin:10px 0 7px}
  .timeline-list strong{display:block;color:#3d5148;font-size:13px;margin:0 0 10px}
  .timeline-list p{font-size:15px;line-height:1.7;color:#64736d;margin:0 0 10px}
  .timeline-list a{font-size:12px;font-weight:800;color:#426837;border-bottom:1px solid #abc0a0;padding-bottom:3px}
  .timeline-branch{position:relative;margin:38px 0 36px 36px;padding:24px 26px 22px;background:#e9eee5;border-left:2px solid #90b774;border-radius:0 16px 16px 0}
  .timeline-branch:before,.timeline-branch:after{content:'';position:absolute;left:-80px;width:80px;height:2px;background:#90b774}
  .timeline-branch:before{top:0}.timeline-branch:after{bottom:0}
  .timeline-branch .branch-dot{position:absolute;left:-9px;top:28px;width:16px;height:16px;border:3px solid #e9eee5;border-radius:50%;background:#90b774;box-shadow:0 0 0 2px #90b774}
  .timeline-branch h4{font:800 clamp(24px,2.7vw,32px)/1.2 'Manrope',sans-serif;letter-spacing:-.04em;margin:8px 0}
  .timeline-branch p{max-width:880px;margin-bottom:0}
  .timeline-resume{margin-top:28px}.timeline-resume>p{margin:10px 0 0}
  .timeline-impact{list-style:none;border-top:1px solid #d7ded8;margin:24px 0 0;padding:0}
  .timeline-impact li{border-bottom:1px solid #d7ded8}
  .timeline-impact a,.timeline-impact .highlight-content{display:grid;grid-template-columns:minmax(210px,310px) 1fr;gap:30px;padding:20px 0;border:0;color:inherit}
  .timeline-impact a:hover h4,.timeline-impact a:focus-visible h4{color:#426837}
  .timeline-impact .highlight-date{display:block;font:500 10px 'DM Mono',monospace;color:#779358;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px}
  .timeline-impact h4{font:800 clamp(18px,1.9vw,23px)/1.32 'Manrope',sans-serif;letter-spacing:-.035em;color:#53753c;margin:0}
  .timeline-impact span{font:500 13px/1.6 'Manrope',sans-serif;color:#4d6157}
  .timeline-impact small{display:block;font:500 10px 'DM Mono',monospace;color:#779358;margin-top:6px}
  @media(max-width:700px){.timeline{padding-top:80px}.timeline-heading{margin-bottom:35px}.timeline-list{padding-left:25px}.timeline-list>li:before{left:-35px}.timeline-branch{margin-left:20px;padding:20px 18px}.timeline-branch:before,.timeline-branch:after{left:-48px;width:48px}}
  @media(max-width:640px){.timeline-impact a,.timeline-impact .highlight-content{grid-template-columns:1fr;gap:9px}.timeline-impact h4{font-size:20px}.connect>div{flex-wrap:wrap}}
</style>
