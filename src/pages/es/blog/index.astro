---
import Base from '../../../layouts/Base.astro';
import { postsEs as posts, postUrl } from '../../../lib/posts.js';
const labels = { research: 'Nota de investigación', projects: 'Proyecto', blog: 'Nota personal' };
---
<Base locale="es" title="Blog — Pepe Zamudio" description="Notas de investigación, proyectos e ideas de José Antonio «Pepe» Zamudio Amaya.">
  <div class="wrap page-intro"><div class="eyebrow">Blog</div><h1>Notas desde<br />el trabajo.</h1><p>Decisiones de investigación, ideas sobre pruebas y la vida académica que hay detrás.</p></div>
  <div class="wrap rule"></div>
  <section class="wrap archive">{posts.length ? <><div class="archive-top"><span class="section-kicker">Archivo / {posts.length} entradas</span><div class="filters" aria-label="Filtrar artículos"><button type="button" class="selected" data-filter="all">Todos</button><button type="button" data-filter="research">Investigación</button><button type="button" data-filter="projects">Proyectos</button><button type="button" data-filter="blog">Notas</button></div></div><div class="article-grid">{posts.map((post) => <a class="article-card" data-group={post.group} href={postUrl(post, 'es')}><div class="article-meta"><span>{labels[post.group]}</span><time datetime={post.date}>{new Date(`${post.date}T12:00:00`).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}</time></div><h2>{post.title}</h2><p>{post.description}</p><span class="article-arrow">Leer entrada ↗</span></a>)}</div><p class="no-results" hidden>Todavía no hay entradas en esta categoría.</p></> : <div class="empty-state"><span class="section-kicker">En preparación</span><h2>Escribir bien lleva tiempo.</h2><p>Por ahora, los artículos y repositorios cuentan mejor lo que estoy haciendo.</p><a class="pill-button" href="/es/research/">Ver publicaciones ↗</a></div>}</section>
  <script>
    document.addEventListener('astro:page-load', () => {
      const buttons = document.querySelectorAll('[data-filter]');
      const cards = document.querySelectorAll('[data-group]');
      const empty = document.querySelector('.no-results');
      buttons.forEach((button) => button.addEventListener('click', () => {
        buttons.forEach((item) => item.classList.toggle('selected', item === button));
        let shown = 0;
        cards.forEach((card) => {
          const visible = button.dataset.filter === 'all' || button.dataset.filter === card.dataset.group;
          card.hidden = !visible;
          if (visible) shown += 1;
        });
        empty.hidden = shown > 0;
      }));
    });
  </script>
  <style>.empty-state{background:#e9eee5;border-radius:22px;padding:52px;max-width:760px}.empty-state h2{font:800 clamp(30px,4vw,48px)/1.15 'Manrope',sans-serif;letter-spacing:-.05em;margin:20px 0}.empty-state p{font-size:17px;line-height:1.65;color:#5d6f68;margin:0 0 30px}@media(max-width:620px){.empty-state{padding:30px}}</style>
</Base>
<style>.archive{padding-top:42px}.archive-top{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px}.filters{display:flex;gap:5px;flex-wrap:wrap}.filters button{border:1px solid transparent;border-radius:999px;background:none;color:#6a7b72;padding:8px 14px;cursor:pointer;font:700 12px 'DM Sans',sans-serif}.filters button:hover{color:#243b3e}.filters button.selected{background:#253b3c;color:#fff}.article-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}.article-card{display:flex;flex-direction:column;min-height:345px;padding:27px;background:#fff;border:1px solid #e1e6df;border-radius:20px;transition:transform .2s,box-shadow .2s}.article-card:hover{transform:translateY(-4px);box-shadow:0 16px 30px #30403c10}.article-card[hidden]{display:none}.article-meta{display:flex;justify-content:space-between;gap:12px;font:500 10px 'DM Mono',monospace;color:#799053;text-transform:uppercase;letter-spacing:.05em}.article-meta time{color:#8b9b92}.article-card h2{font:800 23px/1.22 'Manrope',sans-serif;letter-spacing:-.045em;margin:34px 0 14px}.article-card p{font-size:13px;line-height:1.65;color:#667871;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.article-arrow{font-size:12px;font-weight:800;margin-top:auto;padding-top:25px}.no-results{color:#667871;padding:20px}@media(max-width:900px){.article-grid{grid-template-columns:1fr 1fr}}@media(max-width:620px){.article-grid{grid-template-columns:1fr}.archive-top{align-items:start;flex-direction:column}.article-card{min-height:280px}}</style>
