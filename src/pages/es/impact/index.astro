---
import Base from '../../../layouts/Base.astro';
import ExternalReach from '../../../components/ExternalReach.astro';
import { projects, contributions, advisories, honors, researchFunding, softwareReach, externalRepositoryReach } from '../../../lib/data.js';
import { projectCopy, contributionCopy, advisoryCopy, honorCopy, translateRecords } from '../../../lib/es-data.js';
const projectsEs = translateRecords(projects, projectCopy, 'title');
const contributionsEs = translateRecords(contributions, contributionCopy, 'repo');
const advisoriesEs = translateRecords(advisories, advisoryCopy, 'id');
const honorsEs = translateRecords(honors, honorCopy, 'year');
const starCount = softwareReach.stars.reduce((total, item) => total + item.count, 0);
const downloadCount = softwareReach.downloads.reduce((total, item) => total + item.count, 0);
---
<Base locale="es" title="Impacto — Pepe Zamudio" description="Software de investigación, correcciones de fallos y seguridad, y avisos públicos de José Antonio «Pepe» Zamudio Amaya.">
  <div class="wrap page-intro"><div class="eyebrow">Impacto</div><h1>Herramientas, arreglos<br />y avisos.</h1><p>Software de mi investigación doctoral, correcciones en otros proyectos, avisos públicos de seguridad, reconocimientos y financiación conseguida.</p></div>
  <div class="wrap rule"></div>
  <section class="wrap work-list" id="projects">{projectsEs.map((project) => <article class="work-item"><div class="work-number">{project.number}<span> / {project.label}</span></div><div class="work-main"><span class="work-kind">{project.kind}</span><h2><a href={project.url} target="_blank" rel="noopener noreferrer">{project.title} <span>↗</span></a></h2><p>{project.description}</p><div class="work-links"><a href={project.url} target="_blank" rel="noopener noreferrer">Ver repositorio ↗</a>{project.story && <a href={project.story} target="_blank" rel="noopener noreferrer">Leer artículo ↗</a>}</div></div></article>)}</section>
  <section class="wrap software-reach" id="software-reach" aria-labelledby="reach-title">
    <div class="section-heading"><div><span class="section-kicker">Alcance del software libre</span><h2 class="section-title" id="reach-title">Uso de mis herramientas.</h2></div></div>
    <div class="reach-grid">
      <div class="reach-card"><strong>{starCount.toLocaleString('es-ES')}</strong><h3>estrellas en GitHub</h3><p>En mis {softwareReach.repositoryCount} repositorios públicos originales, tanto de mi cuenta como de la organización Fandango que fundé.</p><ul>{softwareReach.stars.map((item) => <li><a href={item.url} target="_blank" rel="noopener noreferrer">{item.name} <span>{item.count.toLocaleString('es-ES')} ↗</span></a></li>)}</ul></div>
      <div class="reach-card"><strong>{downloadCount.toLocaleString('es-ES')}</strong><h3>Descargas de software, histórico</h3><p>Descargas en PyPI de todos los paquetes de mi perfil de mantenimiento, del paquete público de Fandango en GitHub y de los archivos de publicación de mis repositorios. Son eventos de descarga, no usuarios únicos.</p><ul>{softwareReach.downloads.map((item) => <li><a href={item.url} target="_blank" rel="noopener noreferrer">{item.name} <span>{item.count.toLocaleString('es-ES')} ↗</span></a></li>)}</ul></div>
    </div>
    <p class="reach-date">Datos comprobados el 4 de noviembre de 2026.</p>
  </section>
  <section class="wrap contributions" id="fixes"><div class="section-heading"><div><span class="section-kicker">Otros repositorios</span><h2 class="section-title">Correcciones de fallos y seguridad.</h2></div></div><div class="record-list">{contributionsEs.map((item) => <article class="record"><span class="record-side">{item.date}<br />{item.repo}</span><div><h3><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a></h3><p>{item.detail}</p><ExternalReach repo={item.repo} locale="es" /></div><a class="record-arrow" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Ver el pull request de ${item.title}`}>↗</a></article>)}</div></section>
  <section class="wrap advisories" id="advisories"><div class="section-heading"><div><span class="section-kicker">Solo registros públicos</span><h2 class="section-title">Avisos de seguridad.</h2></div></div><div class="advisory-grid">{advisoriesEs.map((item) => <article class="advisory"><div><span>{item.id}</span><a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Leer ${item.id}`}>↗</a></div><h3><a href={item.url} target="_blank" rel="noopener noreferrer">{item.product}</a></h3><p>{item.title}</p><small>{item.role}</small><ExternalReach repo={item.repo} inverse locale="es" /></article>)}</div><p class="external-reach-note">Descargas de paquetes y estrellas de GitHub por proyecto, comprobadas el 4 de noviembre de 2026. Las descargas incluyen instalaciones repetidas y automatizadas; ninguna de las dos cifras mide instalaciones afectadas. No hay datos públicos de descargas históricas para los proyectos de Java y Go. El historial de adm-zip en npm comienza en 2015.</p></section>
  <section class="wrap funding" id="funding" aria-labelledby="funding-title">
    <div><span class="section-kicker">Apoyo a la investigación</span><h2 class="section-title" id="funding-title">Financiación conseguida.</h2></div>
    <div class="funding-card"><div class="funding-value"><strong>{researchFunding.amount}</strong><span>{researchFunding.currency}</span></div><p>Conseguí esta financiación para avanzar mi investigación en generación rápida de entradas, pruebas centradas en características y herramientas abiertas para probar software complejo.</p></div>
  </section>
  <section class="wrap awards" id="awards" aria-labelledby="awards-title">
    <div class="section-heading"><div><span class="section-kicker">Reconocimientos</span><h2 class="section-title" id="awards-title">Premios y distinciones.</h2></div></div>
    <div class="record-list">
      <div class="record award-pending"><span class="record-side">2026<br />Anuncio pendiente</span><div><span class="award-redaction" aria-hidden="true"></span><p>Publicaré los detalles después del 12 de noviembre de 2026.</p></div></div>
      {honorsEs.map((honor) => <a class="record" href={honor.source} target="_blank" rel="noopener noreferrer"><span class="record-side">{honor.year}<br />{honor.institution}</span><div><h3>{honor.title} <span class="award-distinction">({honor.distinction})</span></h3><p>{honor.detail}</p></div><span class="record-arrow">↗</span></a>)}
    </div>
  </section>

</Base>
<style>.work-list{padding-top:35px}.work-item{display:grid;grid-template-columns:205px 1fr;gap:42px;padding:39px 0;border-bottom:1px solid #d8dfd8}.work-number{font:800 20px 'Manrope',sans-serif;color:#76935b}.work-number span{display:block;margin-top:10px;color:#7d8b83;font:500 10px/1.5 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em}.work-kind{font:500 11px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.12em;color:#7c9574}.work-main h2{font:800 clamp(35px,5vw,62px)/1.1 'Manrope',sans-serif;letter-spacing:-.055em;margin:10px 0 13px}.work-main h2 span{font-size:.5em;vertical-align:top;color:#9ebf69}.work-main h2 a:hover{text-decoration:underline;text-decoration-color:#a4d552;text-underline-offset:7px}.work-main p{color:#62716e;line-height:1.7;max-width:650px;margin:0 0 22px}.work-links{display:flex;gap:25px;flex-wrap:wrap}.work-links a{font-size:12px;font-weight:800;border-bottom:1px solid #b3c0b5;padding-bottom:4px}.contributions,.advisories{padding-top:110px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:30px}.record-list{border-top:1px solid #d3ddd4}.record{display:grid;grid-template-columns:220px 1fr 25px;gap:25px;align-items:center;border-bottom:1px solid #d3ddd4;padding:24px 0;transition:padding .2s}.record:hover{padding-left:8px}.record-side{font:500 11px/1.8 'DM Mono',monospace;color:#758a74}.record h3{font:800 21px/1.3 'Manrope',sans-serif;letter-spacing:-.035em;margin:0 0 6px}.record p{font-size:13px;color:#6f8076;margin:0}.record-arrow{font-size:20px}.advisory-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.advisory{background:#243b3e;color:#fff;border-radius:20px;padding:28px;min-height:255px;display:flex;flex-direction:column;transition:transform .2s}.advisory:hover{transform:translateY(-4px)}.advisory>div{display:flex;justify-content:space-between;color:#c2e388;font:500 11px 'DM Mono',monospace}.advisory h3{font:800 36px 'Manrope',sans-serif;letter-spacing:-.05em;margin:25px 0 8px}.advisory p{color:#d5e0d9;line-height:1.5;margin:0 0 20px}.advisory small{margin-top:auto;color:#b7cfc3;font:500 11px 'DM Mono',monospace}@media(max-width:700px){.work-item{grid-template-columns:1fr;gap:14px}.work-number span{display:inline;margin-left:15px}.section-heading{align-items:start;flex-direction:column}.record{grid-template-columns:1fr 20px;gap:8px}.record-side{grid-column:1/-1}.advisory-grid{grid-template-columns:1fr}}</style>

<style>
  .software-reach{padding-top:110px}
  .reach-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .reach-card{background:#e9eee5;border-radius:20px;padding:30px;min-height:320px;display:flex;flex-direction:column}
  .reach-card strong{font:800 clamp(52px,6vw,78px)/1 'Manrope',sans-serif;letter-spacing:-.07em;color:#253b3c}
  .reach-card h3{font:800 19px 'Manrope',sans-serif;letter-spacing:-.035em;margin:17px 0 7px}
  .reach-card p{font-size:13px;line-height:1.6;color:#61716a;max-width:500px;margin:0 0 20px}
  .reach-card ul{list-style:none;margin:auto 0 0;padding:0;border-top:1px solid #cbd9c8}
  .reach-card li{border-bottom:1px solid #cbd9c8}
  .reach-card li a{display:flex;justify-content:space-between;gap:12px;padding:10px 0;font-size:12px;font-weight:800}
  .reach-card li span{white-space:nowrap;color:#5d7c4e}
  .reach-date{font:500 10px 'DM Mono',monospace;color:#7b8a82;margin:13px 0 0}
  .funding{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;padding-top:110px;padding-bottom:10px}
  .funding-card{background:#253b3c;border-radius:20px;color:#fff;padding:32px 38px;min-height:200px;display:flex;flex-direction:column;justify-content:space-between}
  .funding-value{display:flex;align-items:start;gap:12px}
  .funding-value strong{font:800 clamp(55px,6vw,82px)/1 'Manrope',sans-serif;letter-spacing:-.07em;color:#c1e680}
  .funding-value span{font:500 11px 'DM Mono',monospace;letter-spacing:.08em;color:#bfd1c6;margin-top:11px}
  .funding-card p{font-size:15px;line-height:1.65;color:#d2dfd7;max-width:540px;margin:20px 0 0}
  .awards{padding-top:110px;padding-bottom:20px}
  .award-distinction{color:#72953e}
  .award-redaction{display:block;height:17px;width:min(290px,80%);border-radius:3px;background:#253b3c;margin:4px 0 10px}
  .award-pending:hover{padding-left:0}
  @media(max-width:900px){.funding{grid-template-columns:1fr;gap:24px}}
  @media(max-width:700px){.software-reach{padding-top:80px}.reach-grid{grid-template-columns:1fr}.reach-card{min-height:0}.funding{padding-top:80px}.funding-card{padding:27px;min-height:200px}.awards{padding-top:80px}}
</style>

<style>
  .record h3 a:hover,.record h3 a:focus-visible,.advisory h3 a:hover,.advisory h3 a:focus-visible{text-decoration:underline;text-underline-offset:4px}
  .record-arrow{justify-self:end}
  .external-reach-note{margin:18px 0 0;color:#708078;font:500 11px/1.6 'DM Mono',monospace}
</style>
